  "database_path": "scada_uploader.sqlite",
  "log_path": "scada_uploader.log",
  "date_formats": ["%Y-%m-%d", "%d-%m-%Y", "%d/%m/%Y", "%Y/%m/%d", "%d.%m.%Y"],
  "time_formats": ["%H:%M:%S", "%H:%M:%S.%f", "%H:%M"]
